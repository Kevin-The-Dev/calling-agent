# ─────────────────────────────────────────────────────────────────────────────
# backend/.env  —  AI Voice Sales Agent
#
# Copy to `.env` and fill the values marked  ‼️ FILL IN.
# Everything else already has a working default — leave it alone unless you
# know why you're changing it.
#
# This file is the TEMPLATE and is safe to commit.
# The real `.env` must NEVER be committed (see root .gitignore).
#
# ⚠️ THIS FILE CONFIGURES LOCAL DEVELOPMENT ONLY.
#
#    src/lib/env.ts skips loading it entirely when it detects Vercel:
#
#        if (process.env['VERCEL'] === '1') return;
#
#    So editing `.env` can NEVER change how the deployed backend behaves. On
#    Vercel every value below must be set in the project's Environment
#    Variables, under the Production scope, and the project redeployed —
#    saving the variable alone does nothing to a deployment already built.
#
#    This is worth knowing because the failure is silent: the deploy succeeds,
#    the new code is live, and the old value is still in force. The symptom
#    that led here was ALLOWED_ORIGINS being edited in this file while the
#    deployed backend went on rejecting the frontend's origin.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. KIMI  (LLM)                                              ‼️ FILL IN — all 3
# ═════════════════════════════════════════════════════════════════════════════
# From your Moonshot / Kimi console. The base URL is OpenAI-compatible and
# claude.md §4 says it is supplied here rather than hardcoded.

KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=


# ─────────────────────────────────────────────────────────────────────────────
# 1b. LLM PROVIDER SELECTION                              (decision D9)
# ─────────────────────────────────────────────────────────────────────────────
# The Kimi Code key above reasons before every reply (~2.4s to the first spoken
# word), which is unusable for live speech. GLM was benchmarked and selected.
# Set LLM_PROVIDER to pick which block below the backend actually uses.

# Options: glm | kimi | groq | gemini
LLM_PROVIDER=glm

# ── GLM / Zhipu (active) ─────────────────────────────────────────────────────
# ⚠️ ANTHROPIC-shaped endpoint, not OpenAI-shaped: POST /v1/messages with an
#    x-api-key header. The backend uses an Anthropic-style adapter for it.
# ⚠️ A GLM *Coding Plan* key only works through /api/anthropic. The
#    OpenAI-compatible /api/paas/v4 path returns 429 "insufficient balance"
#    unless you have pay-as-you-go credit. See implementation.md R14.
#
# Benchmarked time-to-first-spoken-token (streaming):
#     glm-4.5-flash  0.87s median  ← chosen
#     glm-4.6        1.13s
#     glm-4.5-air    1.57s
#     glm-5.2        1.16–3.19s, too jittery for live speech
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_API_STYLE=anthropic
GLM_ANTHROPIC_VERSION=2023-06-01
GLM_MODEL=glm-4.5-flash
GLM_EXTRACTOR_MODEL=glm-4.5-flash
GLM_KEEPALIVE=true

# ── Alternatives, if GLM's terms or region become a problem ──────────────────
# Groq   — free tier, OpenAI-compatible, US-hosted, fastest available.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
# Gemini — free tier, no credit card, very low time-to-first-token.
GEMINI_API_KEY=
GEMINI_MODEL=


# ═════════════════════════════════════════════════════════════════════════════
# 2. SUPABASE                                                 ‼️ FILL IN — all 4
# ═════════════════════════════════════════════════════════════════════════════
# Supabase dashboard → Project Settings → API
#   SUPABASE_URL              → "Project URL"
#   SUPABASE_ANON_KEY         → "anon / public"
#   SUPABASE_SERVICE_ROLE_KEY → "service_role"   ⚠️ SERVER ONLY. Never expose
#                               this to the browser — it bypasses every RLS
#                               policy in database.md.
#   SUPABASE_JWT_SECRET       → ⚠️ MOVED. It is no longer under Settings → API.
#                               New location: Project Settings → **JWT Keys**
#                               → "Legacy JWT Secret" tab.
#
#                               Supabase now defaults new projects to asymmetric
#                               "JWT Signing Keys" instead of one shared secret.
#                               If your project shows only signing keys and no
#                               legacy secret, LEAVE THIS EMPTY — the backend
#                               will verify dashboard tokens against the public
#                               JWKS endpoint instead, which is the more secure
#                               path anyway:
#                                 https://<project-ref>.supabase.co/auth/v1/jwks
#
#                               Do NOT click "Migrate JWT secret" just to fill
#                               this in. JWKS verification needs no secret.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
# 3. APP SECRETS                                              ✅ pre-generated
# ═════════════════════════════════════════════════════════════════════════════
# Signs the short-lived call token the widget uses to authenticate its turns.
# A fresh random value has been generated for you. Generate a DIFFERENT one for
# production with:  openssl rand -hex 32

CALL_TOKEN_SECRET=4fd811077680b2ee184e77e04407e23f509513041706a9d8176606daf1ac7219
CALL_TOKEN_TTL_SECONDS=3600


# ═════════════════════════════════════════════════════════════════════════════
# 4. VOICE PROVIDERS                                          ✅ leave as-is
# ═════════════════════════════════════════════════════════════════════════════
# Decision D8: the MVP runs entirely on browser speech — no keys, no cost.
# To upgrade later, flip a provider to `deepgram` / `elevenlabs` and fill its
# key. Nothing else in the codebase changes.

# Options: browser | deepgram   /   browser | elevenlabs
STT_PROVIDER=browser
TTS_PROVIDER=browser

# post-MVP only — leave empty
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# ═════════════════════════════════════════════════════════════════════════════
# 5. AGENT IDENTITY  (seeds agent_settings on first run)      ⚠️ before LAUNCH
# ═════════════════════════════════════════════════════════════════════════════
# These fill the [UNKNOWN] placeholders in docs/knowledge/company-context.md §8.
# The PDFs do not contain them, and the agent will NEVER invent them — if a
# value is empty it uses the fallback response instead of answering.
# Not needed for M1. Needed before a real call.
#
#   COMPANY_NAME      → answers "who are you with?"
#   AGENT_NAME        → what the agent calls itself in the opening
#   CONSULTANT_NAME   → decision D6: the name used in the closing recap.
#                       If empty, the agent says "one of our engineers".
#   SERVICE_AREA      → the neighborhood/region framing
#   CALLBACK_NUMBER   → given on request
#   DEFAULT_TIMEZONE  → IANA name; drives appointment slot generation

COMPANY_NAME=
AGENT_NAME=
CONSULTANT_NAME=
SERVICE_AREA=
CALLBACK_NUMBER=
DEFAULT_TIMEZONE=America/Los_Angeles


# ═════════════════════════════════════════════════════════════════════════════
# 6. RUNTIME TUNING                                           ✅ leave as-is
# ═════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# CORS — comma-separated. Add your production domain before deploying.
#
# The browser calls this backend from the frontend's origin, so every origin the
# site is served from has to be listed or the request is rejected before it
# reaches any route. An origin missing here surfaces in the browser as a bare
# "Failed to fetch" with no further explanation — the same symptom as the
# backend being down — so check this list first when the deployed site cannot
# reach a backend that is plainly running.
#
# Vercel gives a project several hostnames. Use the STABLE ones:
#
#   your-frontend-alpha.vercel.app                  ← the alias. Use this.
#   your-frontend-git-main-you.vercel.app           ← per-branch. Stable too.
#   your-frontend-h53u0oaer-you.vercel.app          ← per-DEPLOYMENT. Do NOT use.
#
# The third kind is regenerated on every single push, so listing one here works
# until the next deploy and then silently stops. Each is a separate origin as
# far as the browser is concerned.
#
#   ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend-git-main-you.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# LLM behaviour (conversational call; the extractor always runs at temp 0)
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=300
LLM_TIMEOUT_MS=15000
# How long a reply may go silent MID-SENTENCE before the turn gives up on the
# rest of it. The timeout above covers the whole request, which is right before
# anything has been said and far too long after: a stream that stalled after one
# sentence held the microphone for the full 15s and then delivered nothing more.
LLM_STREAM_STALL_MS=5000

# Conversation guardrails — see docs/knowledge/conversation-flow.md
MAX_AIR_CYCLES=2
MAX_LATE_OBJECTIONS=4
SILENCE_TIMEOUT_MS=6000

# Booking — see docs/knowledge/appointment-booking.md §3
BOOKING_HORIZON_DAYS=14
SLOT_MINUTES=45
MORNING_WINDOW=09:00-12:00
AFTERNOON_WINDOW=13:00-18:00

# Rate limits
RATE_LIMIT_TURNS_PER_MIN=30
RATE_LIMIT_CALLS_PER_HOUR=5

# Recording retention (days) — transcripts are kept permanently
RECORDING_RETENTION_DAYS=180

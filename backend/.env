# ─────────────────────────────────────────────────────────────────────────────
# backend/.env  —  AI Voice Sales Agent
#
# Copy to `.env` and fill the values marked  ‼️ FILL IN.
# Everything else already has a working default — leave it alone unless you
# know why you're changing it.
#
# This file is the TEMPLATE and is safe to commit.
# The real `.env` must NEVER be committed (see root .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. KIMI  (LLM)                                              ‼️ FILL IN — all 3
# ═════════════════════════════════════════════════════════════════════════════
# From your Moonshot / Kimi console. The base URL is OpenAI-compatible and
# claude.md §4 says it is supplied here rather than hardcoded.

KIMI_API_KEY=sk-kimi-fun2oJOwAyUTVsGgfAxqEPvhklPTc9zXQowo5MJdd9vf4UObKaevU2xpNLQcwqI5
# Verified working endpoint. The OpenAI SDK appends "/chat/completions" to this,
# so the "/v1" is required — "https://api.kimi.com/coding/" alone returns 404.
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding


# ─────────────────────────────────────────────────────────────────────────────
# 1b. ALTERNATIVE LLM PROVIDERS  (candidates — see implementation.md R14)
# ─────────────────────────────────────────────────────────────────────────────
# The Kimi Code key reasons before every reply (~2.4s to first spoken word),
# which is too slow for live speech. These are the OpenAI-compatible candidates
# to replace it. Fill in whichever you have and I'll benchmark them head to head
# on a real conversational turn before we commit.
#
# LLM_PROVIDER selects which one the backend actually uses.
# Options: glm | kimi | groq | gemini
LLM_PROVIDER=glm

# ── GLM / Zhipu  (ACTIVE — decision D9) ──────────────────────────────────────
# ⚠️ This key is an ANTHROPIC-shaped endpoint, not OpenAI-shaped. The backend
#    uses an Anthropic-style adapter for it (POST /v1/messages, x-api-key
#    header). Verified working 2026-08-05.
#
# ⚠️ The OpenAI-compatible endpoint (/api/paas/v4) returns HTTP 429
#    "余额不足" — insufficient balance. This key ONLY works via /api/anthropic.
#    That means it is a GLM *Coding Plan* subscription, same category as the
#    Kimi Code key. See implementation.md R14 before going to production.
#
# Benchmarked time-to-first-SPOKEN-token (streaming, real sales turn):
#     glm-4.5-flash  0.87s median (0.77–0.91 over 5 runs)   ← chosen
#     glm-4.6        1.13s
#     glm-4.5-air    1.57s
#     glm-5.2        1.16–3.19s, highly variable            ← too slow + jittery
#     glm-4-flash    unavailable on this key
GLM_API_KEY=637e2647b5104160bb7b4a9ef74601d8.EGeJxbsJ6W3EPy0C
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_API_STYLE=anthropic
GLM_ANTHROPIC_VERSION=2023-06-01

# Conversational model — on the critical path, latency is everything.
GLM_MODEL=glm-4.5-flash

# Extractor model — runs in parallel, off the critical path. Forced tool_use
# verified working and accurate. Measured ~5s, which is acceptable only because
# nothing waits on it mid-turn; it must finish before the NEXT prospect reply.
GLM_EXTRACTOR_MODEL=glm-4.5-flash

# The API is China-hosted: TLS handshake alone measured 0.32s from the US.
# Keep connections alive so that cost is paid once per call, not once per turn.
GLM_KEEPALIVE=true

# Groq — free tier, OpenAI-compatible, by far the fastest option available.
#   Key: https://console.groq.com  →  https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# Google Gemini — free tier, no credit card, very low time-to-first-token.
#   Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=


# ═════════════════════════════════════════════════════════════════════════════
# 2. SUPABASE                                                 ‼️ FILL IN — all 4
# ═════════════════════════════════════════════════════════════════════════════
# Supabase dashboard → Project Settings → API
#   SUPABASE_URL              → "Project URL"
#   SUPABASE_ANON_KEY         → "anon / public"
#   SUPABASE_SERVICE_ROLE_KEY → "service_role"   ⚠️ SERVER ONLY. Never expose
#                               this to the browser — it bypasses every RLS
#                               policy in database.md.
#   SUPABASE_JWT_SECRET       → ⚠️ MOVED — no longer under Settings → API.
#                               Now: Project Settings → JWT Keys → "Legacy JWT
#                               Secret". New projects default to asymmetric JWT
#                               Signing Keys and may have no legacy secret at
#                               all. If yours doesn't, LEAVE IT EMPTY — the
#                               backend verifies admin tokens against the public
#                               JWKS endpoint instead (more secure, no secret):
#                                 https://<project-ref>.supabase.co/auth/v1/jwks
#                               Don't click "Migrate JWT secret" just to fill it.

# NOTE: this is the API Project URL, not the Postgres connection string.
# The connection string (postgresql://...) is only for migrations, and it
# contains your DB password — it must never be used as SUPABASE_URL.
SUPABASE_URL=https://jxbaaxlceccvoglvqbtx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp4YmFheGxjZWNjdm9nbHZxYnR4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4MzE5NTQsImV4cCI6MjEwMTQwNzk1NH0.Y6qw1O3HcQQQzsJbfx61fYSej9JxixQ7XGDNI9J4ocw
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp4YmFheGxjZWNjdm9nbHZxYnR4Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTgzMTk1NCwiZXhwIjoyMTAxNDA3OTU0fQ.BxUq2t_0Hw24ykUMjDGmUwMdHjnldHAoah2MvOAXZFM
SUPABASE_JWT_SECRET=

# ── Migration credentials (OPTIONAL — only needed to apply migrations) ───────
# The app itself never uses these. They exist so migrations can be pushed
# without pasting SQL by hand. Pick ONE:
#
# (A) Pooler connection string — VERIFIED WORKING, migrations applied 2026-08-05
#
#     Must be the SHARED POOLER host, not `db.<ref>.supabase.co`. The direct
#     host is IPv6-only (Supabase removed IPv4 from direct connections; a
#     dedicated IPv4 address is a paid Pro add-on). The shared Supavisor pooler
#     is IPv4 and free on every plan — that is the supported path here.
#
#     Note the username format: `postgres.<project-ref>`, not plain `postgres`.
#     Project region: ap-northeast-1 (Tokyo).
SUPABASE_DB_URL=postgresql://postgres.jxbaaxlceccvoglvqbtx:postgres12343@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
#
# (B) Personal access token
#     https://supabase.com/dashboard/account/tokens → "Generate new token"
#     Enables: the Management API, which can execute SQL without the DB
#     password. Scoped to your account — revoke it after setup.
SUPABASE_ACCESS_TOKEN=
#
# Project ref (already known — derived from your project URL)
SUPABASE_PROJECT_REF=jxbaaxlceccvoglvqbtx


# ═════════════════════════════════════════════════════════════════════════════
# 3. APP SECRETS                                              ✅ pre-generated
# ═════════════════════════════════════════════════════════════════════════════
# Signs the short-lived call token the widget uses to authenticate its turns.
# A fresh random value has been generated for you. Generate a DIFFERENT one for
# production with:  openssl rand -hex 32

CALL_TOKEN_SECRET=4fd811077680b2ee184e77e04407e23f509513041706a9d8176606daf1ac7219
CALL_TOKEN_TTL_SECONDS=3600


# ═════════════════════════════════════════════════════════════════════════════
# 4. VOICE PROVIDERS                                          ✅ leave as-is
# ═════════════════════════════════════════════════════════════════════════════
# Decision D8: the MVP runs entirely on browser speech — no keys, no cost.
# To upgrade later, flip a provider to `deepgram` / `elevenlabs` and fill its
# key. Nothing else in the codebase changes.

STT_PROVIDER=browser
TTS_PROVIDER=browser

# post-MVP only — leave empty
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# ═════════════════════════════════════════════════════════════════════════════
# 5. AGENT IDENTITY  (seeds agent_settings on first run)      ⚠️ before LAUNCH
# ═════════════════════════════════════════════════════════════════════════════
# These fill the [UNKNOWN] placeholders in docs/knowledge/company-context.md §8.
# The PDFs do not contain them, and the agent will NEVER invent them — if a
# value is empty it uses the fallback response instead of answering.
# Not needed for M1. Needed before a real call.
#
#   COMPANY_NAME      → answers "who are you with?"
#   AGENT_NAME        → what the agent calls itself in the opening
#   CONSULTANT_NAME   → decision D6: the name used in the closing recap.
#                       If empty, the agent says "one of our engineers".
#   SERVICE_AREA      → the neighborhood/region framing
#   CALLBACK_NUMBER   → given on request
#   DEFAULT_TIMEZONE  → IANA name; drives appointment slot generation

# Quote any value containing spaces — an unquoted one breaks shell-sourced .env.
# ⚠️ These are placeholders. The agent SPEAKS them on live calls, so replace
#    them with real values before any real conversation.
COMPANY_NAME="Solar Energy Solutions"

# AI caller name
AGENT_NAME="Alex"

# Engineer / Consultant shown during appointment booking (decision D6)
CONSULTANT_NAME="Michael"

# Service area (replace with your actual market)
SERVICE_AREA="California"

# Callback number — 555-0100 is a reserved fictional number. Replace before launch.
CALLBACK_NUMBER="+1-800-555-0100"

# Timezone
DEFAULT_TIMEZONE=America/Los_Angeles


# ═════════════════════════════════════════════════════════════════════════════
# 6. RUNTIME TUNING                                           ✅ leave as-is
# ═════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# CORS — comma-separated. Add your production domain before deploying.
ALLOWED_ORIGINS=http://localhost:3000

# LLM behaviour (conversational call; the extractor always runs at temp 0)
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=300
LLM_TIMEOUT_MS=15000
# How long a reply may go silent MID-SENTENCE before the turn gives up on the
# rest of it. The timeout above covers the whole request, which is right before
# anything has been said and far too long after: a stream that stalled after one
# sentence held the microphone for the full 15s and then delivered nothing more.
LLM_STREAM_STALL_MS=5000

# Conversation guardrails — see docs/knowledge/conversation-flow.md
MAX_AIR_CYCLES=2
MAX_LATE_OBJECTIONS=4
SILENCE_TIMEOUT_MS=6000

# Booking — see docs/knowledge/appointment-booking.md §3
BOOKING_HORIZON_DAYS=14
SLOT_MINUTES=45
MORNING_WINDOW=09:00-12:00
AFTERNOON_WINDOW=13:00-18:00

# Rate limits
RATE_LIMIT_TURNS_PER_MIN=30
RATE_LIMIT_CALLS_PER_HOUR=5

# Recording retention (days) — transcripts are kept permanently
RECORDING_RETENTION_DAYS=180

# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.local  —  AI Voice Sales Agent
#
# Copy to `.env.local` and fill the values marked  ‼️ FILL IN.
#
# ⚠️ EVERY variable here is prefixed NEXT_PUBLIC_, which means it is inlined
#    into the JavaScript bundle and is PUBLICLY READABLE. Only ever put values
#    here that are safe for anyone to see.
#
#    Never put KIMI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, DEEPGRAM_API_KEY, or
#    ELEVENLABS_API_KEY in this file. Those live in backend/.env only.
#    (claude.md §11)
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# SUPABASE  (browser client — dashboard auth + realtime)      ‼️ FILL IN — both
# ═════════════════════════════════════════════════════════════════════════════
# Same Project URL as the backend, and the ANON key — NOT the service role key.
# The anon key is safe to publish: every table is protected by the row-level
# security policies in database.md §5, so it grants nothing on its own.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# API                                                         ✅ leave as-is
# ═════════════════════════════════════════════════════════════════════════════
# Where the Hono backend lives. Matches PORT in backend/.env for local dev.
# Change to your deployed backend URL for production.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ═════════════════════════════════════════════════════════════════════════════
# WIDGET BEHAVIOUR                                            ✅ leave as-is
# ═════════════════════════════════════════════════════════════════════════════
# Decision D8 — browser speech. These are UI hints only; the backend is the
# authority on which provider actually runs.

NEXT_PUBLIC_VOICE_MODE=browser
NEXT_PUBLIC_STT_LANGUAGE=en-US

# Show the live transcript next to the agent during a call
NEXT_PUBLIC_SHOW_TRANSCRIPT=true

# Require the consent checkbox before the mic turns on (recording consent).
# Keep this true — see implementation.md R1.
NEXT_PUBLIC_REQUIRE_CONSENT=true

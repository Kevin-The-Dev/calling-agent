{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TodoWrite",
      "WebSearch",
      "WebFetch",

      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(vitest *)",
      "Bash(eslint *)",
      "Bash(prettier *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git show*)",
      "Bash(git init*)",

      "Bash(psql *)",
      "Bash(supabase *)",

      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find*)",
      "Bash(which*)",
      "Bash(echo*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(touch*)",
      "Bash(chmod*)",
      "Bash(dig*)",
      "Bash(host*)",
      "Bash(curl*)",
      "Bash(openssl*)",
      "Bash(python3*)",
      "Bash(sed*)",
      "Bash(awk*)",
      "Bash(jq*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(pkill*)",
      "Bash(lsof*)",
      "Bash(kill*)",
      "Bash(sleep*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo rm*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(psql *DROP DATABASE*)",
      "Bash(psql *DROP SCHEMA*)",
      "Bash(psql *TRUNCATE*)"
    ]
  }
}
